meta {
  name: Login cliente
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  "email": "cliente@culturavibe.mx",
  "password": "Cliente123!"
}

script:post-response {
  bru.setVar("tokenCliente", res.body.token);
}

tests {
  test("Login cliente devuelve 200", function () {
    expect(res.status).to.equal(200);
  });
}
