meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  "email": "admin@culturavibe.mx",
  "password": "Admin123!"
}

script:post-response {
  bru.setVar("token", res.body.token);
}

tests {
  test("Login devuelve 200", function () {
    expect(res.status).to.equal(200);
  });
}
