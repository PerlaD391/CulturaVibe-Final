meta {
  name: Importar usuarios DummyJSON
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/admin/usuarios/importar-dummyjson?limit=208
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Importar usuarios devuelve 200", function () {
    expect(res.status).to.equal(200);
  });

  test("La respuesta trae el conteo de importados", function () {
    expect(res.body.importados).to.be.a("number");
  });
}
