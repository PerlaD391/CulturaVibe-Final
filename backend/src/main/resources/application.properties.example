# Copia este archivo como application.properties (o exporta las variables)
# y ajusta los valores. NUNCA pongas secretos reales en el repositorio.
# Variables de entorno que usa el backend del Proyecto Final CulturaVibe:

# --- Base de datos MySQL ---
# DB_URL=jdbc:mysql://localhost:3306/culturavibe_final?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Mexico_City
# DB_USER=root
# DB_PASSWORD=tu_contrasena_mysql

# --- JWT (obligatorio en producción; Base64URL de 32 bytes) ---
# Generar con: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# JWT_SECRET=TU_SECRETO_BASE64URL_DE_32_BYTES

# --- Correo (Postfix en el VPS, localhost:25) ---
# MAIL_FROM=no-reply@culturavibe.mx
# APP_FRONTEND_URL=https://13.140.226.55

# --- SMS por Vonage (va primero; si están vacías, se usa Twilio) ---
# La api_key y el api_secret están en el dashboard de Vonage
# (dashboard.nexmo.com → API Settings) y el número virtual se compra
# en Numbers → Buy numbers. Todo va por variable de entorno, nunca en
# el código ni en GitHub.
# VONAGE_API_KEY=tu_api_key_de_vonage
# VONAGE_API_SECRET=tu_api_secret_de_vonage
# VONAGE_FROM_NUMBER=tu_numero_virtual_de_vonage

# --- Twilio (solo SMS, respaldo si Vonage no está configurado) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
# TWILIO_PHONE_NUMBER=+15551234567

# --- WhatsApp con Meta WhatsApp Cloud API (gratis; si están vacías, se omite el WhatsApp) ---
# El token es temporal (dura 24 h): se genera en developers.facebook.com y
# se pasa por variable de entorno, nunca se pega en el código ni en GitHub.
# WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
# WHATSAPP_ACCESS_TOKEN=tu_token_temporal_de_meta
# WHATSAPP_TEMPLATE_NAME=hello_world

# --- Login con Google (OAuth2; si están vacías, la app arranca igual y el botón no funciona) ---
# Se crean en Google Cloud Console (console.cloud.google.com → APIs y servicios → Credenciales → Crear credenciales → ID de cliente de OAuth → Aplicación web).
# La URI de redirección autorizada debe ser https://culturavibe.duckdns.org/login/oauth2/code/google
# (en local: http://localhost:8086/login/oauth2/code/google).
# GOOGLE_CLIENT_ID=tu_id_de_cliente_de_google
# GOOGLE_CLIENT_SECRET=<redacted>

# --- Ticketmaster (sincronización de eventos a MySQL) ---
# La llave se genera en developer.ticketmaster.com y se pasa por
# variable de entorno; nunca se pega en el código ni en GitHub.
# Sin esta llave, POST /api/admin/ticketmaster/sync responde 503.
# TICKETMASTER_API_KEY=tu_llave_de_ticketmaster

# --- CORS (orígenes separados por comas) ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://13.140.226.55,https://13.140.226.55
