# CulturaVibe — Proyecto Final (frontend)
# Copia este archivo a `.env` y ajusta la URL si tu backend corre en otro
# lugar. NUNCA subas el `.env` real al repositorio (no lleva secretos,
# solo la URL de la API).
# En local, Vite redirige /api al backend (ver vite.config.js), así que
# también puedes poner VITE_API_URL=http://localhost:8086.
VITE_API_URL=http://localhost:8086

# --- Firebase Auth (login con Google por Firebase) ---
# Salen de Firebase Console → Configuración del proyecto → Tus apps
# (app Web, proyecto culturavibe-60142). Sin estas variables, el botón
# "Continuar con Google (Firebase)" avisa que no está configurado.
# Las variables VITE_FIREBASE_* se incrustan en el build del frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
